@* Text with the web addresses in it as links, such as the sign-in page a plugin's health message points to. *@
@foreach (var (text, url) in Parts(Value))
{
    if (url) { <a href="@text" target="_blank" rel="noopener noreferrer">@text</a> }
    else { @text }
}

@code {
    [Parameter] public string? Value { get; set; }

    private static readonly System.Text.RegularExpressions.Regex Url = new(@"https?://[^\s<>""]+[^\s<>"".,;:!?)]");

    private static IEnumerable<(string Text, bool Url)> Parts(string? value)
    {
        if (string.IsNullOrEmpty(value))
            yield break;
        var at = 0;
        foreach (System.Text.RegularExpressions.Match match in Url.Matches(value))
        {
            if (match.Index > at)
                yield return (value[at..match.Index], false);
            yield return (match.Value, true);
            at = match.Index + match.Length;
        }
        if (at < value.Length)
            yield return (value[at..], false);
    }
}
