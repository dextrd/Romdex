@using Romdex.Web.Pages
@inject RomdexClient Api
@inject AuthState Auth
@inject NavigationManager Nav

@*
    The first run, in full screen without the rest of the app: the admin account and anyone else, the ROM library and
    DATs, plugins, API keys and webhooks, then how Romdex looks. Once the admin is made, any
    step can be gone back to or skipped, by the numbers along the bottom. Everything here is in Settings later too.
*@
<div class="setup-page">
    <div class="setup-brand"><Logo />Romdex</div>

    <CascadingValue Name="InSetup" Value="true" IsFixed="true">
    <main class="setup-main">
        <h1>@Steps[_step].Title</h1>
        <p class="muted">@Steps[_step].Intro</p>

        @switch (_step)
        {
            case 0 when !SetUp:
                <form class="card setup-admin" @onsubmit="MakeAdminAsync" @onsubmit:preventDefault="true">
                    <label class="field">
                        <span class="field-label">Username</span>
                        <input type="text" autocomplete="username" @bind="_username" @bind:event="oninput" required autofocus />
                    </label>
                    <label class="field">
                        <span class="field-label">Password</span>
                        <input type="password" autocomplete="new-password" @bind="_password" @bind:event="oninput" required />
                        <span class="muted small">At least 8 characters.</span>
                    </label>
                    <label class="field">
                        <span class="field-label">Password again</span>
                        <input type="password" autocomplete="new-password" @bind="_confirm" @bind:event="oninput" required />
                    </label>
                    @if (_error is not null) { <p class="error small">@_error</p> }
                    <div class="toolbar">
                        <span class="spacer"></span>
                        <button class="primary" type="submit" disabled="@(_busy || _username.Trim().Length == 0 || _password.Length == 0 || _confirm.Length == 0)">
                            @if (_busy) { <span class="spinner"></span> }Make the admin account
                        </button>
                    </div>
                </form>
                break;
            case 0:
                <Users />
                break;
            case 1:
                <FoldersStep />
                break;
            case 2:
                <Plugins InSetup="true" />
                break;
            case 3:
                <ApiKeys />
                <Webhooks />
                break;
            case 4:
                <AppearancePanel ForEveryone="true" />
                break;
            default:
                <div class="card setup-scan">
                    <p>
                        Romdex is ready. Update the catalogue and scan the library from the Library page to see what you have, checked against the DATs.
                        Everything here is in Settings whenever you want to change it.
                    </p>
                    @if (_error is not null) { <p class="error">@_error</p> }
                    <div class="toolbar">
                        <span class="spacer"></span>
                        <button class="primary" disabled="@_busy" @onclick="FinishAsync">
                            @if (_busy) { <span class="spinner"></span> }Open Romdex
                        </button>
                    </div>
                </div>
                break;
        }
    </main>
    </CascadingValue>

    <nav class="setup-nav" aria-label="Setup steps">
        <button class="setup-back" disabled="@(!SetUp || _step == 0)" @onclick="() => Go(_step - 1)">Back</button>
        <ol class="setup-dots">
            @for (var i = 0; i < Steps.Length; i++)
            {
                var step = i;
                <li>
                    <button class="setup-dot @(step == _step ? "current" : step < _step ? "passed" : "")" disabled="@(!SetUp)"
                            aria-current="@(step == _step ? "step" : null)" title="@Steps[step].Name" @onclick="() => Go(step)">
                        <span class="setup-number">@(step + 1)</span>
                        <span class="setup-dot-name">@Steps[step].Name</span>
                    </button>
                </li>
            }
        </ol>
        @if (_step < Steps.Length - 1)
        {
            <button class="primary setup-next" disabled="@(!SetUp)" @onclick="() => Go(_step + 1)">Next</button>
        }
        else
        {
            <span class="setup-next"></span>
        }
    </nav>
</div>

<PageTitle>Set up · Romdex</PageTitle>

@code {
    private sealed record Step(string Name, string Title, string Intro);

    private static readonly Step[] Steps =
    [
        new("People", "Welcome to Romdex", "First, the admin account, which may do everything. Then add anyone else who'll use Romdex, with only what they need. Everyone signs in, even at home."),
        new("Games", "Your games", "Where your ROM library is, and the DATs it's checked against."),
        new("Plugins", "Plugins", "The catalogue your library is checked against, how new dumps arrive, and the apps that use your games. The DAT folder is set up already: add others as you need them."),
        new("API", "Apps and webhooks", "Let other apps use Romdex with API keys, and tell them when things happen with webhooks. Most people can skip this."),
        new("Look", "How Romdex looks", "For everyone, to begin with. Each person can choose their own look later, under Settings → Appearance."),
        new("Done", "All set", "That's everything for now."),
    ];

    private int _step;
    private string _username = "admin";
    private string _password = "";
    private string _confirm = "";
    private bool _busy;
    private string? _error;

    private bool SetUp => Auth.Status?.SetUp == true;

    private void Go(int step)
    {
        if (!SetUp || step < 0 || step >= Steps.Length)
            return;
        _step = step;
        _error = null;
    }

    private async Task MakeAdminAsync()
    {
        if (_password != _confirm)
        {
            _error = "The passwords don't match.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            await Api.SetUpLoginAsync(new SetUpLogin(_username, _password));
            _password = _confirm = "";
            Auth.Set(await Api.GetAuthStatusAsync());
        }
        catch (RomdexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.FinishSetupAsync();
            Nav.NavigateTo("");
            Auth.Set(await Api.GetAuthStatusAsync());
        }
        catch (RomdexApiException e)
        {
            _error = e.Message;
            _busy = false;
        }
    }
}
