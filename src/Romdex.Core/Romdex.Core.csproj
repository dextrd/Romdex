<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Romdex.Core</RootNamespace>
    <!-- The server collector suits busy web servers, taking memory freely and seldom giving it back; Romdex serves a
         household, so the workstation collector keeps it small at no cost anyone would notice. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Romdex.Contracts\Romdex.Contracts.csproj" />
    <ProjectReference Include="..\Romdex.Client\Romdex.Client.csproj" />
    <ProjectReference Include="..\Romdex.Web\Romdex.Web.csproj" />
    <ProjectReference Include="..\Romdex.Plugins.DatFolder\Romdex.Plugins.DatFolder.csproj" />
    <ProjectReference Include="..\Romdex.Plugins.Redump\Romdex.Plugins.Redump.csproj" />
  </ItemGroup>

</Project>
